[TestMerge/should_suppress_mergeProps_and_matchPropsOn_for_reset_keys_while_still_returning_the_value - 1]
{
 "component": "TestComponent",
 "props": {
  "name": "Roman",
  "posts": [
   "fresh"
  ]
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestMerge/should_emit_merge_metadata_for_path_and_deep_merge_configs - 1]
{
 "component": "TestComponent",
 "deepMergeProps": [
  "settings"
 ],
 "matchPropsOn": [
  "conversation.messages.id",
  "settings.key"
 ],
 "mergeProps": [
  "posts",
  "conversation.messages"
 ],
 "prependProps": [
  "notifications"
 ],
 "props": {
  "conversation": {
   "messages": [
    "one"
   ]
  },
  "notifications": [
   "one"
  ],
  "posts": [
   "one"
  ],
  "settings": {
   "theme": "dark"
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

