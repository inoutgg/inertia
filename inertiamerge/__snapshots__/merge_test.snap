
[TestMerge/should_populate_mergeProps_with_NewAppendRoot_for_root-only_append - 1]
{
 "component": "TestComponent",
 "mergeProps": [
  "mergeable"
 ],
 "props": {
  "mergeable": {
   "key": "val"
  },
  "normal": "value"
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestMerge/it_should_suppress_deepMergeProps_and_matchPropsOn_for_reset_keys_when_DeepMerge_is_set - 1]
{
 "component": "TestComponent",
 "props": {
  "settings": {
   "theme": "dark"
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestMerge/it_should_ignore_empty_append,_prepend_and_matchOn_path_segments - 1]
{
 "component": "TestComponent",
 "mergeProps": [
  "posts.data",
  "posts.items"
 ],
 "props": {
  "posts": {
   "data": [
    "one"
   ],
   "items": [
    "two"
   ]
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestMerge/it_should_qualify_matchOn_keys_with_the_prop_root_when_matchOn_paths_are_non-empty - 1]
{
 "component": "TestComponent",
 "matchPropsOn": [
  "conversation.messages.id"
 ],
 "mergeProps": [
  "conversation.messages"
 ],
 "props": {
  "conversation": {
   "messages": [
    "one"
   ]
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

