 "component": "TestComponent",
 "matchPropsOn": [
  "posts.id"
 ],
 "mergeProps": [
  "posts"
 ],
 "props": {
  "posts": [
   "one"
  ]
 },
 "url": "/users",
 "version": "1.0.0"
}
---

