[TestProp/should_emit_merge_metadata_for_path_and_deep_merge_configs - 1]
{
 "component": "TestComponent",
 "deepMergeProps": [
  "settings"
 ],
 "matchPropsOn": [
  "conversation.messages.id",
  "settings.key"
 ],
 "mergeProps": [
  "posts",
  "conversation.messages"
 ],
 "prependProps": [
  "notifications"
 ],
 "props": {
  "conversation": {
   "messages": [
    "one"
   ]
  },
  "notifications": [
   "one"
  ],
  "posts": [
   "one"
  ],
  "settings": {
   "theme": "dark"
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestProp/it_should_skip_once_prop_value_resolution_when_its_key_appears_in_exceptOnceProps_header - 1]
