
[TestScrollProp/should_populate_scrollProps_with_pagination_metadata_on_full_request - 1]
{
 "component": "TestComponent",
 "mergeProps": [
  "users.data"
 ],
 "props": {
  "users": {
   "data": [
    "one"
   ]
  }
 },
 "scrollProps": {
  "users": {
   "currentPage": 1,
   "nextPage": 2,
   "pageName": "page",
   "previousPage": null
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

