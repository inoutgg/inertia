[TestRenderer_PartialComponentMismatch/it_should_behave_like_a_full_render_when_partialComponent_does_not_match_the_rendered_component - 1]
{
 "component": "TestComponent",
 "deferredProps": {
  "default": [
   "deferred"
  ]
 },
 "props": {
  "email": "test@example.com",
  "name": "Roman"
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_PartialResolution/it_should_rescue_multiple_failed_props_aggregating_each_key_into_rescuedProps - 1]
{
 "component": "TestComponent",
 "props": {},
 "rescuedProps": [
  "a",
  "b"
 ],
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_MixedPropTypes/it_should_keep_rescuedProps,_scrollProps_and_mergeProps_consistent_when_a_rescued_deferred_prop_coexists_with_a_scroll_prop_and_a_merge_prop_on_the_same_partial_request - 1]
{
 "component": "TestComponent",
 "mergeProps": [
  "keep",
  "users.data"
 ],
 "props": {
  "keep": [
   "a"
  ],
  "users": {
   "data": [
    "one"
   ]
  }
 },
 "rescuedProps": [
  "rescued"
 ],
 "scrollProps": {
  "users": {
   "currentPage": null,
   "pageName": ""
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

