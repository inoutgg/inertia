
[TestRenderer_PageMetadata/it_should_populate_component,_url_and_version_from_the_context_and_request - 1]
{
 "component": "TestComponent",
 "props": {
  "name": "Roman"
 },
 "url": "/users/123",
 "version": "1.0.0"
}
---

[TestRenderer_MixedPropTypes/it_should_produce_all_metadata_fields_together_when_standard,_deferred,_optional,_once,_merge_and_scroll_props_are_combined_on_a_full_request - 1]
{
 "component": "TestComponent",
 "deferredProps": {
  "default": [
   "notifications"
  ]
 },
 "mergeProps": [
  "feed",
  "users.data"
 ],
 "onceProps": {
  "locale_key": {
   "prop": "locale"
  }
 },
 "props": {
  "feed": [
   {
    "id": 1
   }
  ],
  "locale": "en",
  "stats": "visible",
  "users": {
   "data": [
    "one"
   ]
  }
 },
 "scrollProps": {
  "users": {
   "currentPage": 1,
   "nextPage": 2,
   "pageName": "",
   "previousPage": null
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_PageMetadata/it_should_propagate_preserveFragment,_clearHistory_and_encryptHistory_when_set_on_the_context - 1]
{
 "clearHistory": true,
 "component": "TestComponent",
 "encryptHistory": true,
 "preserveFragment": true,
 "props": {
  "name": "Roman"
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_PageMetadata/it_should_default_preserveFragment,_clearHistory_and_encryptHistory_to_false_when_unset - 1]
{
 "component": "TestComponent",
 "props": {
  "name": "Roman"
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_SharedProps/it_should_list_shared_prop_keys_in_sharedProps_when_shared_props_are_provided - 1]
{
 "component": "TestComponent",
 "props": {
  "name": "Roman"
 },
 "sharedProps": [
  "auth",
  "errors"
 ],
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_MixedPropTypes/it_should_omit_deferredProps_when_no_deferred_props_are_present - 1]
{
 "component": "TestComponent",
 "props": {
  "name": "Roman"
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_FirstLoadIgnorables/it_should_skip_optional_and_deferred_props_on_full_request_without_invoking_their_lazy_functions - 1]
{
 "component": "TestComponent",
 "deferredProps": {
  "default": [
   "def"
  ]
 },
 "props": {},
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_PartialOnceInteraction/it_should_keep_once_prop_on_partial_request_when_its_key_is_whitelisted_despite_exceptOnceProps_listing_it - 1]
{
 "component": "TestComponent",
 "onceProps": {
  "locale_key": {
   "prop": "locale"
  }
 },
 "props": {
  "locale": "lazy-locale"
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_SharedProps/it_should_keep_shared_props_independent_of_partial_whitelist_and_blacklist - 1]
{
 "component": "TestComponent",
 "props": {
  "name": "Roman"
 },
 "sharedProps": [
  "auth"
 ],
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_FirstLoadIgnorables/it_should_still_include_always_and_standard_props_alongside_ignorable_props_on_full_request - 1]
{
 "component": "TestComponent",
 "deferredProps": {
  "default": [
   "def"
  ]
 },
 "props": {
  "auth": {
   "user": "Roman"
  },
  "name": "Roman"
 },
 "url": "/users",
 "version": "1.0.0"
}
---

[TestRenderer_SharedProps/it_should_not_resolve_shared_prop_values_into_Page_props_when_they_are_only_declared_as_shared - 1]
