[TestRenderer_MixedPropTypes/it_should_resolve_every_prop_on_a_partial_request_that_whitelists_the_parent_key_while_omitting_deferredProps_metadata - 1]
{
 "component": "TestComponent",
 "mergeProps": [
  "feed",
  "users.data"
 ],
 "onceProps": {
  "locale_key": {
   "prop": "locale"
  }
 },
 "props": {
  "feed": [
   {
    "id": 1
   }
  ],
  "locale": "en",
  "notifications": [
   "msg"
  ],
  "stats": "visible",
  "users": {
   "data": [
    "one"
   ]
  }
 },
 "scrollProps": {
  "users": {
   "currentPage": null,
   "pageName": ""
  }
 },
 "url": "/users",
 "version": "1.0.0"
}
---

